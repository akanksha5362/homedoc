# Copy to .env and fill in for your environment. Never commit a real .env.

ENVIRONMENT=development

# Defaults to a local SQLite file if unset — see app/core/config.py.
# For staging/production, point this at a real PostgreSQL instance:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/homedoc
DATABASE_URL=sqlite:///./homedoc_dev.db

# REQUIRED in staging/production. The dev-only default in config.py is
# intentionally insecure and must never be used outside local development.
JWT_SECRET_KEY=dev-only-insecure-secret-do-not-use-in-production
JWT_EXPIRY_MINUTES=60

# Leave unset to run entirely on MockLLMProvider (no network call, fully
# deterministic — this is what the test suite and this repo's own
# verification run against). Set this to enable real Gemini calls via
# GeminiProvider — see app/ai/gateway/gemini_provider.py's docstring for
# why that path is untested in the authoring environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
